<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Memoly.UnitTests" />
    <InternalsVisibleTo Include="Memoly.IntegrationTests" />
    <InternalsVisibleTo Include="Memoly.ArchitectureTests" />
  </ItemGroup>
</Project>
